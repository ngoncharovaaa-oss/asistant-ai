# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.
# Все значения ниже необязательны: без .env система работает офлайн на датасете.

# --- Пути ---
# Папка синтетического датасета «ИИкузницы» (inbox.csv, calendar.ics, tasks.csv, meetings/)
DATASET_DIR=./data/kuznitsa
# Куда писать отчёт, дайджест, черновики и протоколы
OUT_DIR=./out
# SQLite-журнал запусков, черновиков, правок и утверждений
DATABASE_PATH=./data/asistant.db

# --- Режим и качество ---
# 1 — детерминированные правила без сети (текущий режим); 0 — резерв под LLM-провайдера
DEMO_MODE=1
# Ниже порога уверенности черновик не готовится, обращение уходит в эскалацию
CONFIDENCE_THRESHOLD=0.75
# Лимит токенов на один запуск пачки
RUN_TOKEN_BUDGET=60000

# --- Экономика ---
# Обращений в месяц — база для расчёта экономии
MONTHLY_REQUESTS=350

# --- LLM: резерв на случай подключения провайдера ---
# В текущей сборке не используется: классификация и черновики считаются правилами.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- Живая почта: ящик А (руководитель) ---
# Пока поля пусты, система работает офлайн на датасете и ничего не отправляет.
MAIL_A_ADDRESS=
MAIL_A_IMAP_HOST=
MAIL_A_IMAP_PORT=993
MAIL_A_SMTP_HOST=
MAIL_A_SMTP_PORT=465
MAIL_A_USER=
MAIL_A_PASSWORD=
MAIL_A_FROM_NAME=

# --- Живая почта: ящик Б (второй/клиентский) ---
MAIL_B_ADDRESS=
MAIL_B_IMAP_HOST=
MAIL_B_IMAP_PORT=993
MAIL_B_SMTP_HOST=
MAIL_B_SMTP_PORT=465
MAIL_B_USER=
MAIL_B_PASSWORD=
MAIL_B_FROM_NAME=

# Сколько последних писем забирать из каждого ящика за один живой прогон
MAIL_FETCH_LIMIT=20

# --- Telegram-бот ---
# Токен выдаёт @BotFather. chat_id узнаётся командой /id в боте и вносится в allow-list.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Через запятую; пусто — команды принимаются только из TELEGRAM_CHAT_ID
TELEGRAM_ALLOWED_CHATS=

# --- Zoom ---
# Вариант 1, без API: постоянная ссылка на вашу комнату — ссылки на встречи
# будут выдаваться без обращения к Zoom.
ZOOM_PERSONAL_LINK=
# Вариант 2, API: Server-to-Server OAuth-приложение в Zoom App Marketplace.
# Нужны Account ID, Client ID и Client Secret; создаётся новая встреча на 45 минут.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Чей календарь использовать: me или почта пользователя Zoom
ZOOM_USER_ID=me

# --- Необязательный справочник для делегирования ---
# data/kuznitsa/contacts.csv с колонками name,email — иначе делегирование
# утверждается без отправки письма (адрес неизвестен).
