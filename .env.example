# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.
# Все значения ниже необязательны: без .env система работает офлайн на датасете.

# --- Пути ---
# Папка синтетического датасета «ИИкузницы» (inbox.csv, calendar.ics, tasks.csv, meetings/)
DATASET_DIR=./data/kuznitsa
# Куда писать отчёт, дайджест, черновики и протоколы
OUT_DIR=./out
# SQLite-журнал запусков, черновиков, правок и утверждений
DATABASE_PATH=./data/asistant.db

# --- Режим и качество ---
# 1 — детерминированные правила без сети (текущий режим); 0 — резерв под LLM-провайдера
DEMO_MODE=1
# Ниже порога уверенности черновик не готовится, обращение уходит в эскалацию
CONFIDENCE_THRESHOLD=0.75
# Лимит токенов на один запуск пачки
RUN_TOKEN_BUDGET=60000

# --- Экономика ---
# Реальный поток: 50–100 писем в день и 25–40 встреч в неделю.
# Средний сценарий считается по середине диапазона писем.
EMAILS_PER_DAY_MIN=50
EMAILS_PER_DAY_MAX=100
WORKDAYS_PER_MONTH=21
MEETINGS_PER_WEEK_MIN=25
MEETINGS_PER_WEEK_MAX=40

# --- LLM: резерв на случай подключения провайдера ---
# В текущей сборке не используется: классификация и черновики считаются правилами.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- Живая почта: ящик А (руководитель) ---
# Пока поля пусты, система работает офлайн на датасете и ничего не отправляет.
MAIL_A_ADDRESS=
MAIL_A_IMAP_HOST=
MAIL_A_IMAP_PORT=993
MAIL_A_SMTP_HOST=
MAIL_A_SMTP_PORT=465
MAIL_A_USER=
MAIL_A_PASSWORD=
MAIL_A_FROM_NAME=

# --- Живая почта: ящик Б (второй/клиентский) ---
MAIL_B_ADDRESS=
MAIL_B_IMAP_HOST=
MAIL_B_IMAP_PORT=993
MAIL_B_SMTP_HOST=
MAIL_B_SMTP_PORT=465
MAIL_B_USER=
MAIL_B_PASSWORD=
MAIL_B_FROM_NAME=

# Сколько последних писем забирать из каждого ящика за один живой прогон
MAIL_FETCH_LIMIT=20

# Реестр дополнительных ящиков (добавляются в дашборде, панель «Почты»).
# По умолчанию data/mailboxes.json и в git не попадает. Менять путь не обязательно.
# MAILBOXES_PATH=

# --- Telegram-бот ---
# Токен выдаёт @BotFather. chat_id узнаётся командой /id в боте и вносится в allow-list.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Через запятую; пусто — команды принимаются только из TELEGRAM_CHAT_ID
TELEGRAM_ALLOWED_CHATS=

# --- Личный Telegram (необязательно) ---
# Непрочитанные и черновики ответов в вашем аккаунте. api_id и api_hash берутся
# на my.telegram.org → API development tools; затем один раз выполните
# `python -m app.cli tg-login` и введите телефон и код в терминале.
# Телефон, код и api_hash не выводятся в чат, журнал и презентацию.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Куда сохранить сессию; по умолчанию data/telegram_user.session (в .gitignore)
# TELEGRAM_SESSION=

# --- Zoom ---
# Вариант 1, вход через приложение Zoom (без пароля Zoom-аккаунта):
# создайте OAuth-приложение (User-managed, Authorization Code) в Zoom App
# Marketplace, добавьте Redirect URL http://127.0.0.1:8000/api/zoom/callback
# и заполните три поля ниже. Кнопка «Войти в Zoom» в дашборде положит токен
# в data/zoom_oauth.json (в .gitignore), «Выйти» его удалит.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Локально — http://127.0.0.1:8000/api/zoom/callback. На публичном стенде
# укажите адрес туннеля и добавьте его в Redirect URLs приложения Zoom.
ZOOM_REDIRECT_URI=http://127.0.0.1:8000/api/zoom/callback
# Вариант 2, без API: постоянную ссылку на вашу комнату можно вставить в панели
# Zoom (data/rooms.json, в .gitignore) или здесь — ссылки будут выдаваться
# без обращения к Zoom.
ZOOM_PERSONAL_LINK=
# Вариант 3, API: Server-to-Server OAuth-приложение в Zoom App Marketplace.
# Нужны Account ID, Client ID и Client Secret; создаётся новая встреча на 45 минут.
ZOOM_ACCOUNT_ID=
# Чей календарь использовать: me или почта пользователя Zoom
ZOOM_USER_ID=me

# --- Телемост ---
# У Телемоста нет публичного API создания встреч: укажите постоянную комнату.
# Откройте telemost.yandex.ru, создайте встречу и вставьте ссылку вида
# https://telemost.yandex.ru/j/12345678901234 — сюда или в панель «Телемост»
# (тогда она ляжет в data/rooms.json). Тема, время и приглашение добавляются
# к этой ссылке, наружу ничего не отправляется. Гостевая ссылка Телемоста
# действует 24 часа, для стабильной работы нужна комната вашего аккаунта.
TELEMOST_LINK=

# --- Необязательный справочник для делегирования ---
# data/kuznitsa/contacts.csv с колонками name,email — иначе делегирование
# утверждается без отправки письма (адрес неизвестен).

# --- Битрикс24 (CRM) ---
# Входящий вебхук портала: CRM → Настройки → Разработчикам → Другое → Входящий вебхук.
# Права: crm (контакты и таймлайн). Скопируйте адрес вида
# https://<портал>.bitrix24.ru/rest/<id>/<код>/ — он содержит секрет,
# поэтому не публикуется и в интерфейс не отдаётся.
BITRIX24_WEBHOOK_URL=
