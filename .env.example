# Скопируйте в .env и заполните. Файл .env в репозиторий не коммитится.

# --- LLM: OpenAI-совместимый провайдер ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

# --- Бюджет и качество ---
# Лимит токенов на один запуск пачки; при превышении агент останавливается и эскалирует
RUN_TOKEN_BUDGET=60000
# Ниже порога уверенности черновик не готовится, обращение уходит в эскалацию
CONFIDENCE_THRESHOLD=0.75

# --- Демо-режим ---
# 1 — ответы модели берутся из кэша, сеть не нужна; 0 — реальные вызовы
DEMO_MODE=1
LLM_CACHE_PATH=./data/llm_cache.json

# --- Данные ---
DATABASE_URL=sqlite:///./data/dvoinik.db
DATASET_PATH=./data/demo_dataset.json

# --- Каналы: mock в демо, реальные адаптеры в пилоте ---
MAIL_ADAPTER=mock
MESSENGER_ADAPTER=mock
CALENDAR_ADAPTER=mock
TRACKER_ADAPTER=mock

# --- Сервер ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Подтверждение отправки и запрет автоотправки — инварианты кода,
# переменной окружения для их отключения нет.
